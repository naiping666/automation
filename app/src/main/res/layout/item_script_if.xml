<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_if_step">

    <!-- 顶部：条件文字 + 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_expand"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_right" />

        <TextView
            android:id="@+id/tv_if_condition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="IF 识别到 &quot;爱加速&quot;"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="8dp" />

        <ImageView
            android:id="@+id/iv_delete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_delete"
            android:padding="4dp" />

        <ImageView
            android:id="@+id/iv_edit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_edit"
            android:padding="4dp" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="8dp" />

    <!-- 条件成立时 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:paddingStart="16dp">

        <TextView
            android:id="@+id/tv_then_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ 条件成立时 (0步)"
            android:textSize="14sp"
            android:textColor="#4CAF50" />

        <!-- ✅ 这里必须使用完整包名 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_then_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingStart="16dp" />

        <TextView
            android:id="@+id/btn_add_then"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ 添加步骤"
            android:textColor="#4CAF50"
            android:padding="8dp"
            android:background="?selectableItemBackground"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 条件不成立时 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp">

        <TextView
            android:id="@+id/tv_else_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❌ 条件不成立时 (0步)"
            android:textSize="14sp"
            android:textColor="#F44336" />

        <!-- ✅ 这里也必须使用完整包名 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_else_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingStart="16dp" />

        <TextView
            android:id="@+id/btn_add_else"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ 添加步骤"
            android:textColor="#F44336"
            android:padding="8dp"
            android:background="?selectableItemBackground"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>